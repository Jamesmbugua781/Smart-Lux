# =============================================================================
# SMART CAMPUS BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider Selection ('gemini' or 'grok')
# Set AI_PROVIDER=gemini to use Google Gemini
# Set AI_PROVIDER=grok to use xAI Grok
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini

# -----------------------------------------------------------------------------
# Google Gemini API Key Configuration
# Get your API key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# AI_API_KEY is supported as an alias for GEMINI_API_KEY
AI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# xAI Grok API Key Configuration
# Get your API key at: https://console.x.ai/
# -----------------------------------------------------------------------------
GROK_API_KEY=YOUR_GROK_API_KEY_HERE
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# -----------------------------------------------------------------------------
# Core Server Configuration
# -----------------------------------------------------------------------------
# PostgreSQL Connection String (Format: postgresql://username:password@localhost:5432/database_name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_campus_db
RATE_LIMIT=10/minute
